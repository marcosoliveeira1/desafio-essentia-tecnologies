# Copie para .env (nunca commitar o .env): cp .env.example .env
#
# Exemplo para DEV LOCAL (API fora do compose: npm run dev, e2e) — DB_*/MONGO_*
# apontam para localhost. O docker-compose NÃO lê este arquivo: ele usa o .env
# da raiz do repo (ver .env.example na raiz, que só define o JWT_SECRET).

# ---- App ----
NODE_ENV=development
APP_HOST=0.0.0.0
APP_PORT=3000

# ---- MySQL (dev — API local) ----
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=todo
DB_PASSWORD=todo
DB_DATABASE=todo_dev

# ---- MySQL (test — e2e backend via fastify.inject, T7/T8) ----
DB_TEST_HOST=localhost
DB_TEST_PORT=3306
DB_TEST_USERNAME=todo
DB_TEST_PASSWORD=todo
DB_TEST_DATABASE=todo_test

# ---- Auth JWT (extra Fase 5) ----
# Obrigatória em QUALQUER ambiente — sem fallback dev (boot falha sem ela).
# Gere: `openssl rand -base64 32`
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRES_IN=12h

# ---- CORS (PR-05) ----
# CSV de origens permitidas (allowlist explícita).
# Unset: dev/test libera `*`; em production o plugin NÃO é registrado
# (same-origin via Caddy).
# CORS_ORIGINS=http://localhost:4200,http://localhost:80

# ---- Swagger (PR-06) ----
# Default ligado fora de production; em production é opt-in via "true".
# O compose de demo força "true" (remova para fechar /api/docs).
# SWAGGER_ENABLED=true

# ---- Rate limit (PR-03) ----
# Defaults: max 5 req / janela 60000ms; sem allowlist (exceto NODE_ENV=test,
# que allowlista 127.0.0.1).
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW=60000
# RATE_LIMIT_ALLOWLIST=127.0.0.1

# ---- MongoDB (extra Fase 6 — histórico de atividades) ----
# O compose exige auth: usuário app criado por docker/db/mongo-init.js
# (readWrite em todo_activity + todo_activity_test), authSource=admin.
# Se seu volume mongo é anterior ao auth, rode `docker compose down -v` (apaga dados dev).
MONGO_URL=mongodb://todo:todo@localhost:27017/todo_activity?authSource=admin

# ---- MongoDB (test — e2e de histórico T22, isolado do banco dev) ----
MONGO_TEST_URL=mongodb://todo:todo@localhost:27017/todo_activity_test?authSource=admin
