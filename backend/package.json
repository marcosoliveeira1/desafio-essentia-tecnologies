{
	"name": "backend",
	"version": "0.1.0",
	"private": true,
	"description": "Essentia Todo List — API (Fastify + TypeScript + MySQL)",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "tsx watch src/main.ts",
		"build": "tsc",
		"test": "vitest run test/unit --passWithNoTests",
		"test:e2e": "vitest run test/e2e --passWithNoTests",
		"test:mutation": "stryker run",
		"typecheck": "tsc --noEmit",
		"seed": "tsx src/seed.ts",
		"lint": "biome check src test"
	},
	"dependencies": {
		"@fastify/cors": "^11.0.1",
		"@fastify/helmet": "^13.1.1",
		"@fastify/jwt": "^10.0.0",
		"@fastify/rate-limit": "^11.2.0",
		"@fastify/swagger": "^9.8.1",
		"@fastify/swagger-ui": "^6.1.1",
		"@fastify/type-provider-typebox": "^6.1.0",
		"@sinclair/typebox": "^0.34.52",
		"bcryptjs": "^3.0.3",
		"fastify": "^5.3.1",
		"mongodb": "^6.21.0",
		"mysql2": "^3.14.1",
		"reflect-metadata": "^0.2.2",
		"typeorm": "^0.3.26"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@stryker-mutator/core": "^10.0.0",
		"@stryker-mutator/vitest-runner": "^10.0.0",
		"@types/bcryptjs": "^2.4.6",
		"@types/node": "^22.15.30",
		"tsx": "^4.19.4",
		"typescript": "^5.8.3",
		"vitest": "^3.2.3"
	}
}
