# Copie para .env (o compose lê o .env da raiz automaticamente): cp .env.example .env
# Gere um valor real com: openssl rand -base64 32
#
# Única variável OBRIGATÓRIA lida do ambiente host pelo docker-compose.yml
# (fail-fast: ${JWT_SECRET:?...} — sem ela o `docker compose up` nem sobe).
# Opcionais (interpolação ${VAR:-default} no compose, defaults de dev):
# MYSQL_ROOT_PASSWORD, MYSQL_USER, MYSQL_PASSWORD,
# MONGO_ROOT_USERNAME, MONGO_ROOT_PASSWORD, MONGO_APP_USERNAME, MONGO_APP_PASSWORD.
# Demais valores (DB_*, MONGO_URL, APP_*) estão fixos no compose para o modo
# prod-like; para dev local use backend/.env.example.

JWT_SECRET=change-me-min-32-chars-gere-com-openssl-rand-base64-32
